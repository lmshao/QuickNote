{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNote",
  "version": "0.1.1",
  "identifier": "com.lmshao.quicknote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickNote",
        "width": 640,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
